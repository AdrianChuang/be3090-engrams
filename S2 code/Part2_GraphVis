import matplotlib.pyplot as plt
import scipy.io as sio
import numpy as np

from scipy.signal import find_peaks

data = sio.loadmat('session2_b_variable_length_12.mat')  # Load in the .mat file containing neuron activity data

activity = data['neuron_network_imaging'][0][0] # Extract the neuron activity data from the loaded .mat file

#print(activity.shape)
#print(activity.dtype)
#print(activity[:5, :5])

"""Visualize Neuron activity of one neuron over time"""
#plt.plot(activity[:,49])
#plt.xlabel('Time (frames)')
#plt.ylabel('Activity')
#plt.show()

peaks = [] # Initialize an empty list to store peak indices for each neuron

for neuron in range(200):        #Loop through each neuron and find peaks, addding the indices of the peaks to the peaks list
    peakindices,_ = find_peaks(activity[:, neuron], height = 100, distance = 10)
    peaks.append(peakindices)

enconding = np.zeros((200, activity.shape[0])) # Initialize a 2D array to store the encoding of neuron activity

plt.figure(figsize=(12, 8))

for neuron in range(200):
    plt.vlines(peaks[neuron], neuron, neuron + 0.8)

plt.xlabel('Time (frames)')
plt.ylabel('Neuron Index')
plt.show()

enc = np.zeros((activity.shape[1], activity.shape[0]))   # neurons × time
for neuron, idx in enumerate(peaks):
    enc[neuron, idx] = 1

T = enc.shape[1]
lags = range(1, T // 2)
sim = [np.sum(enc[:, :T-lag] * enc[:, lag:]) / (T - lag) for lag in lags]

plt.plot(lags, sim)
plt.xlabel('Lag (frames)')
plt.ylabel('Similarity')
plt.show()