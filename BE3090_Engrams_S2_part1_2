import scipy.io as sio               # load .mat file
import numpy as np                   # array math
from scipy.signal import find_peaks  # detect firings

activity = sio.loadmat('session2_a_misfire_12.mat')['neuron_network_imaging']  # (1000, 200)

engram = []
for neuron in range(activity.shape[1]):                     # check every neuron
    peaks, _ = find_peaks(activity[:, neuron], height=100, distance=10) # Looks for fluorescence peaks that represent neuronal firing.
    recalls = set(p // 100 for p in peaks)                  # which of the 10 recalls it fired in
    if len(recalls) >= 7:                                   # Keeps a neuron if it fired in at least 7 of the 10 recalls.
        engram.append((np.median([p % 100 for p in peaks]), neuron + 1))  # Finds the neuron's typical firing time

engram.sort()                                               # order by firing time
print('engram sequence:', [n for t, n in engram])
